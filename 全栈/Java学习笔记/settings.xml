<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven settings 速查：Maven 3.9.x / Settings 1.2.0；可选均已注释，按场景启用。
    用户级 ~/.m2/settings.xml；全局 ${maven.home}/conf/settings.xml；冲突以用户级为准。
    -s / -gs 可指定；放在项目目录不会自动加载。
    POM 管项目构建；settings 管本地仓、镜像、认证、代理与本机差异。
    ${} 只认系统属性与 ${env.变量}；激活的 settings profile properties 可被 POM 引用。
    检查：mvn -s <本文件路径> help:effective-settings；help:active-profiles

    ── <id> 关系（多数互不对齐；proxy.id ≠ mirror.id）────────────────
      proxy.id        出网 HTTP 代理条目名；不对齐任何 mirror / repository
      server.id       认证 → 对齐实际生效目标：
                        走镜像 = mirror.id；直连 = repository.id；发布 = distributionManagement 目标 id
      mirror.id       镜像自己的名字；走镜像时对 servers
      mirrorOf        （非 id）匹配被劫持的 repository / pluginRepository 的 id
                      （不是 URL、不是 mirror.id、不是 profile.id）
      profile.id      本机开关（-P / activeProfiles）；不参与 mirrorOf
      repository.id   仓库逻辑名；被 mirrorOf 匹配；直连时对 servers

      本文件示例分层：
        profile.id=company-repo
          └── repository.id=company-direct  ← mirrorOf 对象；直连时对 servers
        mirror.id=company-mirror            ← 走镜像时对 servers
        mirrorOf=central|*|…                ← 被替换的仓库 id
        proxy.id=company-proxy              ← 独立，与上列全无对应

      要点：proxy 管出网、mirror 管下载改道，可同时开。mirrorOf=* 时声明的直连 URL
      仍被镜像替换，认证按实际目标（通常 mirror.id）找 servers；真直连用 *,!repoId。
      deploy 走 distributionManagement，不被 mirror 改写。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://maven.apache.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <!-- 本地仓库默认如下；-Dmaven.repo.local= 可临时覆盖。 -->
    <!-- <localRepository>${user.home}/.m2/repository</localRepository> -->
    <!-- interactiveMode 默认 true（CI 用 -B）；offline 默认 false（-o）。 -->
    <!-- <interactiveMode>true</interactiveMode> -->
    <!-- <offline>false</offline> -->

    <!-- proxies：出网代理，不是仓库账号；与 mirrors 正交，id 互不对齐。nonProxyHosts 用 |，支持 *。 -->
    <proxies>
        <!--
        <proxy>
            <id>company-proxy</id>
            <active>true</active>
            <protocol>http</protocol>
            <host>proxy.example.com</host>
            <port>8080</port>
            <username>${env.PROXY_USER}</username>
            <password>${env.PROXY_PASSWORD}</password>
            <nonProxyHosts>localhost|127.0.0.1|*.example.com</nonProxyHosts>
        </proxy>
        -->
    </proxies>

    <!--
        servers：只认证，不写仓库 URL；密码/token 用 ${env.变量} 或加密（mvn -emp / -ep）。
        id 对齐见文件头「<id> 关系」。
    -->
    <servers>
        <!--
        <server>
            <id>company-mirror</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        <server>
            <id>company-releases</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        <server>
            <id>company-snapshots</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        -->
        <!-- SSH：privateKey 填路径，勿同时设 password。 -->
        <!--
        <server>
            <id>company-ssh</id>
            <username>${env.REPO_USER}</username>
            <privateKey>${user.home}/.ssh/id_ed25519</privateKey>
            <passphrase>${env.SSH_KEY_PASSPHRASE}</passphrase>
        </server>
        -->
    </servers>

    <!--
        mirrors：只换下载源，不改 deploy。匹配与认证见文件头「<id> 关系」。
        mirrorOf 常用：central | * | external:* | *,!repoId | repo1,repo2
          central     只换 Super POM 默认中央仓（不必写 profile；按 id 字符串，非域名——
                      别的 URL 若也叫 central 一样被劫持）
          *           全部远程仓（含 company-direct）都走镜像；入口须能提供全部制品（私服仓库组）
          *,!repoId   除 repoId 外走镜像（该仓直连，认证用 servers.id=repoId）
          external:*  只镜像非 file、非本机（localhost / 127.0.0.1）的外部仓
        按 <mirrors> 声明顺序取首个命中（精确 id 写在 * 前）；失败不回退原仓。
        缺制品靠私服代理回源（不是 Maven 绕开 mirror）。Maven 3.8.1+ 默认阻止外部 HTTP。

        下列 Super POM 默认仓（Maven 3.9.x）仅说明用，勿取消注释进 settings；
        mirrorOf=central 针对这里的 id=central（依赖仓与插件仓各一份，id 相同）。
    -->
    <!--
    <repositories>（Super POM 默认，仅说明用）
        <repository>
            <id>central</id>
            <name>Central Repository</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <layout>default</layout>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>（Super POM 默认，仅说明用）
        <pluginRepository>
            <id>central</id>
            <name>Central Repository</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <layout>default</layout>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>
    -->
    <mirrors>
        <!-- 下列示例择一启用（勿同时开 central + *）。 -->
        <!--
        <mirror>
            <id>aliyun-central</id>
            <name>Aliyun Central</name>
            <url>https://maven.aliyun.com/repository/central</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
        <mirror>
            <id>company-mirror</id>
            <name>Company Repository Group</name>
            <url>https://repo.example.com/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
            <mirrorOfLayouts>*</mirrorOfLayouts>
            <blocked>false</blocked>
        </mirror>
        -->
    </mirrors>

    <!--
        settings profile：仅 id / activation / properties / repositories / pluginRepositories。
        -P、property、jdk、os、file 或 activeProfiles 激活；多条件 AND。
        activeByDefault 遇同容器其他已激活 profile 会退让。
        profile.id 只是开关；repository.id 才参与 mirrorOf / 直连认证（见文件头）。
        激活后 repositories 并入解析候选（与 Super POM central 并列）；被 mirrorOf=* 命中仍走镜像。
        repositories=依赖下载，pluginRepositories=插件下载；central 默认关快照。
    -->
    <profiles>
        <!--
        <profile>
            <id>company-repo</id>
            <activation>
                <property><name>useCompanyRepo</name><value>true</value></property>
            </activation>
            <properties><team.build.label>local</team.build.label></properties>
            <repositories>
                <repository>
                    <id>company-direct</id>
                    <url>https://repo.example.com/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                        <updatePolicy>daily</updatePolicy>
                        <checksumPolicy>fail</checksumPolicy>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>daily</updatePolicy>
                        <checksumPolicy>fail</checksumPolicy>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>company-direct</id>
                    <url>https://repo.example.com/repository/maven-public/</url>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
        -->
    </profiles>

    <activeProfiles>
        <!-- <activeProfile>company-repo</activeProfile> -->
    </activeProfiles>

    <!-- 插件前缀搜索组；内置 org.apache.maven.plugins / org.codehaus.mojo。 -->
    <pluginGroups>
        <!-- <pluginGroup>com.example.maven.plugins</pluginGroup> -->
    </pluginGroups>
</settings>
