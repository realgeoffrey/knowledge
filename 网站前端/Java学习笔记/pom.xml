<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven POM 速查示例：Maven 3.9.x / POM 4.0.0；未注释部分为最小构建，注释块按场景启用。
    POM 管依赖、插件、模块；账号 / 代理 / 镜像放 settings.xml。示例版本不代表最新。
    参考：https://maven.apache.org/pom.html
          https://maven.apache.org/ref/3.9.15/maven-model/maven.html
    检查：mvn validate；help:effective-pom -Dverbose；dependency:tree
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- POM 模型版本，不是 Maven / Java 版本。 -->
    <modelVersion>4.0.0</modelVersion>

    <!--
        parent：只能一个；可继承属性、依赖管理、插件配置；groupId/version 可省略继承。
        relativePath 默认 ../pom.xml；空元素关闭相对查找。无显式 parent 仍继承 Super POM。
        父 POM 的 dependencies 会继承；dependencyManagement 只提供管理规则。
    -->
    <!--
    <parent>
        <groupId>com.example</groupId>
        <artifactId>example-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    -->

    <!-- GAV；SNAPSHOT 可变，release 应不可变。多模块可用 ${revision}（CI Friendly，见 README）。 -->
    <groupId>com.example</groupId>
    <artifactId>java-study-notes</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- packaging 默认 jar，决定默认插件绑定；常见 war、pom、maven-plugin。 -->
    <packaging>jar</packaging>
    <name>java-study-notes</name>
    <description>Maven configuration examples for Java study notes.</description>

    <!-- 项目元信息：按发布要求填写，不参与依赖仲裁。 -->
    <!--
    <url>https://example.com/java-study-notes</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>Example Team</name>
        <url>https://example.com</url>
    </organization>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>dev001</id>
            <name>Developer Name</name>
            <email>developer@example.com</email>
            <roles><role>developer</role></roles>
            <timezone>Asia/Shanghai</timezone>
        </developer>
    </developers>
    <contributors>
        <contributor><name>Contributor Name</name></contributor>
    </contributors>
    <mailingLists>
        <mailingList>
            <name>Users</name>
            <post>users@example.com</post>
            <archive>https://example.com/archive</archive>
        </mailingList>
    </mailingLists>
    -->

    <!-- modules 只聚合构建；启用时 packaging 改为 pom。 -->
    <!--
    <modules>
        <module>common</module>
        <module>service</module>
    </modules>
    -->

    <!-- SCM / 缺陷 / CI 元信息；connection 读、developerConnection 写。 -->
    <!--
    <scm>
        <connection>scm:git:https://example.com/team/repo.git</connection>
        <developerConnection>scm:git:ssh://git@example.com/team/repo.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://example.com/team/repo</url>
    </scm>
    <issueManagement>
        <system>GitHub</system><url>https://example.com/team/repo/issues</url>
    </issueManagement>
    <ciManagement>
        <system>Jenkins</system><url>https://ci.example.com/job/demo</url>
    </ciManagement>
    -->

    <!--
        distributionManagement：deploy 上传目标（非下载源）；认证按 id 取 settings/servers。
        快照优先 snapshotRepository；site 供 site:deploy，mvn site 只生成站点。
    -->
    <!--
    <distributionManagement>
        <repository>
            <id>company-releases</id>
            <url>https://repo.example.com/repository/releases/</url>
        </repository>
        <snapshotRepository>
            <id>company-snapshots</id>
            <url>https://repo.example.com/repository/snapshots/</url>
        </snapshotRepository>
        <site>
            <id>company-site</id>
            <url>https://docs.example.com/java-study-notes/</url>
        </site>
    </distributionManagement>
    -->

    <!--
        properties：${名称} 引用；内置如 ${project.version}、${env.CI}。-D 可覆盖同名项。
        ${java.version} 不是编译目标；用 maven.compiler.release（JDK 9+ 约束语法/字节码/API）。
        参考：https://maven.apache.org/plugins/maven-compiler-plugin/examples/set-compiler-release.html
    -->
    <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 固定归档时间利于可复现构建；还需固定 JDK、依赖、插件。 -->
        <!-- <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp> -->
    </properties>

    <!--
        dependencyManagement：统一版本/scope/exclusions，不引入依赖；不管插件自身依赖。
        BOM：type=pom + scope=import；当前 POM 显式管理优先，多 BOM 通常先导入者优先。
        业务依赖慎用版本区间。匹配键 GA + type + classifier。
    -->
    <!--
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.13.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    -->

    <!--
        dependencies：直接依赖 + 传递解析；代码直接用的库应显式声明。
        scope：compile 默认；provided/test 不向下游传递；system 应避免；import 仅 BOM。
        optional / exclusions 见 README。版本仲裁：显式 > 管理 > 路径最近、同深度先声明。
        参考：https://maven.apache.org/guides/introduction/introduction-to-dependency-mechanism.html
    -->
    <dependencies>
        <!-- 须同时启用上方 JUnit BOM；测试插件见 build/plugins。 -->
        <!--
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        -->
        <!--
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>sample-client</artifactId>
            <version>1.0.0</version>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>com.example</groupId>
                    <artifactId>legacy-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        -->
    </dependencies>

    <!--
        repositories：依赖下载；Super POM 已有 central。releases/snapshots + updatePolicy/checksumPolicy。
        机器差异与认证放 settings；-U 查更新快照/缺失 release，不升级固定版本。
    -->
    <!--
    <repositories>
        <repository>
            <id>company-releases</id>
            <url>https://repo.example.com/repository/releases/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
                <checksumPolicy>fail</checksumPolicy>
            </releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    -->
    <!-- pluginRepositories：插件下载，结构同 repositories。 -->
    <!--
    <pluginRepositories>
        <pluginRepository>
            <id>company-plugins</id>
            <url>https://repo.example.com/repository/plugins/</url>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>
    -->

    <!--
        默认目录：src/main|test/{java,resources} → target/{classes,test-classes}。
        package 只打包；install → 本地仓库；deploy → 远程（不是启动应用）。
        普通 jar 不内嵌依赖；Boot 可执行包需 spring-boot-maven-plugin:repackage。
    -->
    <build>
        <!-- finalName 只改文件名不改坐标；defaultGoal 在 mvn 无目标时生效。 -->
        <!--
        <defaultGoal>verify</defaultGoal>
        <directory>target</directory>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <outputDirectory>target/classes</outputDirectory>
        <testOutputDirectory>target/test-classes</testOutputDirectory>
        -->

        <!-- resources：filtering 默认 false；勿对二进制过滤；注意与 Spring ${} 冲突。 -->
        <!--
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>build-info.properties</exclude></excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>build-info.properties</include></includes>
            </resource>
        </resources>
        <filters><filter>src/main/filters/build.properties</filter></filters>
        -->

        <!-- extensions：构建扩展；启动期核心扩展用 .mvn/extensions.xml。 -->
        <!--
        <extensions>
            <extension>
                <groupId>com.example</groupId>
                <artifactId>example-build-extension</artifactId>
                <version>1.0.0</version>
            </extension>
        </extensions>
        -->

        <!-- pluginManagement：版本/默认配置；经 plugins 或生命周期绑定后才执行。 -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!--
            plugins：configuration + executions（phase + goals）；同插件多次执行用多个 execution。
            inherited=false 阻止继承；插件 dependencies 独立于项目依赖管理。
            运行 JDK 看 mvn -v；独立编译/测试 JDK 用 Toolchains，不是只改 release。
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Surefire 默认绑 test；配合上方 JUnit 依赖。 -->
            <!--
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            -->

            <!--
                Failsafe：绑 integration-test + verify；用 mvn verify。
                -DskipTests / -DskipITs / -Dmaven.test.skip=true；Failsafe 3.6.0+ 不直接认 skipTests。
                参考：https://maven.apache.org/surefire/maven-failsafe-plugin/usage.html
            -->
            <!--
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
            </plugin>
            -->

            <!-- 普通项目用 Enforcer 限制环境；也可加 dependencyConvergence / requireUpperBoundDeps。 -->
            <!--
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>check-build-environment</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                                <requireJavaVersion><version>[1.8,)</version></requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            -->
        </plugins>
    </build>

    <!-- reporting 用于 mvn site；与 build/plugins 分工不同。 -->
    <!--
    <reporting>
        <outputDirectory>${project.build.directory}/site</outputDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <reportSets>
                    <reportSet><id>api</id><reports><report>javadoc</report></reports></reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>
    -->

    <!--
        profiles：-P 或 property/jdk/os/file 激活（多条件 AND）。Maven profile ≠ Spring profile。
        同 POM 其他 profile 已激活时，activeByDefault 通常停用。
        参考：https://maven.apache.org/guides/introduction/introduction-to-profiles.html
    -->
    <!--
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <property><name>env</name><value>dev</value></property>
            </activation>
            <properties><build.label>dev</build.label></properties>
        </profile>
    </profiles>
    -->
</project>
