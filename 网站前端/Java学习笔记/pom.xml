<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven POM 速查示例：以 Maven 3.9.x / POM 4.0.0 为基准，保留 Java 8 编译目标。
    未注释部分是最小构建；注释中的 XML 按场景启用，示例坐标、地址和版本按项目替换。
    POM 管依赖、插件和模块；账号、代理、镜像放 settings.xml。示例版本不代表最新版本。
    参考：https://maven.apache.org/pom.html
          https://maven.apache.org/ref/3.9.15/maven-model/maven.html
    检查：mvn validate；mvn help:effective-pom -Dverbose；mvn dependency:tree
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- POM 模型版本，不是 Maven / Java 版本。 -->
    <modelVersion>4.0.0</modelVersion>

    <!--
        parent：只能继承一个父 POM；可继承属性、依赖管理和插件配置，groupId/version 可省略继承。
        relativePath 默认 ../pom.xml；空元素关闭相对路径查找。无显式 parent 仍继承 Super POM。
        父 POM 的 dependencies 会被继承；dependencyManagement 只提供管理规则。
    -->
    <!--
    <parent>
        <groupId>com.example</groupId>
        <artifactId>example-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    -->

    <!-- GAV 标识项目版本；SNAPSHOT 内容可变，release 应保持不可变。 -->
    <groupId>com.example</groupId>
    <artifactId>java-study-notes</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- packaging 默认 jar，决定默认插件绑定；常见 war、pom、maven-plugin。 -->
    <packaging>jar</packaging>
    <name>java-study-notes</name>
    <description>Maven configuration examples for Java study notes.</description>

    <!-- 项目元信息：按发布要求填写，不参与普通依赖仲裁。contributors 与 developer 类似，但无 id。 -->
    <!--
    <url>https://example.com/java-study-notes</url>
    <inceptionYear>2026</inceptionYear>
