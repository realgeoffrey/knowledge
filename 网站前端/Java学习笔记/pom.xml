    <!-- modules 是聚合，不自动继承或建立模块依赖；启用时将当前 packaging 改为 pom。 -->
    <!--
    <modules>
        <module>common</module>
        <module>service</module>
    </modules>
    -->

    <!-- SCM / 缺陷 / CI 元信息；scm/tag 默认 HEAD，connection 与 developerConnection 分别用于读写连接。 -->
    <!--
    <scm>
        <connection>scm:git:https://example.com/team/repo.git</connection>
        <developerConnection>scm:git:ssh://git@example.com/team/repo.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://example.com/team/repo</url>
    </scm>
    <issueManagement>
        <system>GitHub</system><url>https://example.com/team/repo/issues</url>
    </issueManagement>
    <ciManagement>
        <system>Jenkins</system><url>https://ci.example.com/job/demo</url>
    </ciManagement>
    -->

    <!--
        distributionManagement 是上传目标，不是 dependencies 的下载源；认证按 id 从 settings/servers 取。
        快照优先用 snapshotRepository，未配置则回退 repository；服务端须允许对应版本。
        site 是 site:deploy / site-deploy 的目标；mvn site 只生成站点。
        relocation 用于旧坐标迁移；status 由仓库工具维护，uniqueVersion 属历史配置，不作为快照覆盖开关。
    -->
    <!--
    <distributionManagement>
        <repository>
            <id>company-releases</id>
            <url>https://repo.example.com/repository/releases/</url>
        </repository>
        <snapshotRepository>
            <id>company-snapshots</id>
            <url>https://repo.example.com/repository/snapshots/</url>
        </snapshotRepository>
        <site>
            <id>company-site</id>
            <url>https://docs.example.com/java-study-notes/</url>
        </site>
    </distributionManagement>
    -->

    <!--
        properties 用 ${名称} 引用；内置属性如 ${project.version}、${project.basedir}、${env.CI}。
        CLI 的 -D 可覆盖多数同名项目属性；${java.version} 本身不是 Maven 的编译目标配置。
        release 在 JDK 9+ 同时约束语言、字节码和 Java SE API；source/target 不限制可用 API。
        Compiler Plugin 3.13.0+ 在 JDK 8 上把 release=8 转为 source/target；编译 JDK 必须支持目标版本。
        参考：https://maven.apache.org/plugins/maven-compiler-plugin/examples/set-compiler-release.html
    -->
    <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 固定归档时间有助于可复现构建，还需固定 JDK、依赖、插件及构建输入。 -->
        <!-- <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp> -->
    </properties>

    <!--
        dependencyManagement 统一版本 / scope / exclusions，不引入依赖；也不管理插件自身依赖。
        匹配键为 groupId + artifactId + type + classifier；默认 jar、无 classifier 时通常只写 GA。
        BOM 以 type=pom、scope=import 导入版本清单，不导入插件配置；下面选用支持 Java 8 的 JUnit 5。
        管理冲突：当前 POM 显式管理优先于导入 BOM；多个 BOM 管理同项时通常先导入者优先。
    -->
    <!--
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.13.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    -->

    <!--
        dependencies 引入直接依赖并解析传递依赖；代码直接使用的库应显式声明。
        scope：compile 默认，编译/测试/运行；provided 编译/测试、运行由环境提供；runtime 测试/运行；test 仅测试。
        provided/test 不向下游传递；system + systemPath 绑定本机 jar，应避免；import 只用于上方依赖管理。
        type 默认 jar；classifier 区分 sources/tests 等附加制品；type=test-jar 默认对应 classifier=tests 的 jar。
        optional=true：当前项目使用、下游需自行声明；exclusions 仅切断当前路径，其他路径仍可引入。
        直接依赖的显式版本优先于管理默认值；传递版本先按管理规则，否则路径最近、同深度先声明优先。
        参考：https://maven.apache.org/guides/introduction/introduction-to-dependency-mechanism.html
    -->
    <dependencies>
        <!-- 此例须同时启用上方 JUnit BOM；测试执行插件见 build/plugins。 -->
        <!--
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        -->
        <!-- 虚构内部库示例：假设 sample-client 传递引入 legacy-logging；实际使用时替换坐标。 -->
        <!--
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>sample-client</artifactId>
            <version>1.0.0</version>
            <optional>true</optional>
            <exclusions>
                <exclusion>
                    <groupId>com.example</groupId>
                    <artifactId>legacy-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        -->
    </dependencies>

    <!--
        repositories 管依赖下载；Super POM 已提供 central，按需增加团队共享来源。
        releases/snapshots.enabled 控制版本类型；updatePolicy=always/daily(默认)/interval:分钟/never。
        checksumPolicy=fail/warn/ignore；Maven 3 默认 warn，下面示例采用 fail。
        机器差异与认证放 settings；镜像可能替换此处地址。-U 检查更新快照和缺失 release，不升级固定版本。
    -->
    <!--
    <repositories>
        <repository>
            <id>company-releases</id>
            <url>https://repo.example.com/repository/releases/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
                <checksumPolicy>fail</checksumPolicy>
            </releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    -->
    <!-- pluginRepositories 管插件及其依赖下载，策略结构与 repositories 相同。 -->
    <!--
    <pluginRepositories>
        <pluginRepository>
            <id>company-plugins</id>
            <url>https://repo.example.com/repository/plugins/</url>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>
    -->

    <!--
        build 默认：src/main/java、src/test/java；资源 src/main/resources、src/test/resources。
        输出为 target/classes、target/test-classes，产物通常为 target/${project.artifactId}-${project.version}.jar。
        package 只打包；install 安装到本地仓库；deploy 发布到远程仓库，不是启动应用。
        普通 jar 不内嵌依赖；Boot 可执行包需配置 spring-boot-maven-plugin:repackage，BOM 不会替你绑定它。
    -->
    <build>
        <!-- 目录通常沿用默认值；finalName 只改文件名，不改坐标；defaultGoal 在 mvn 无目标时生效。 -->
        <!--
        <defaultGoal>verify</defaultGoal>
        <directory>target</directory>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <outputDirectory>target/classes</outputDirectory>
        <testOutputDirectory>target/test-classes</testOutputDirectory>
        -->

        <!--
            resources 复制资源，filtering 默认 false；开启后替换占位符，别对二进制文件开启过滤。
            示例只过滤 build-info.properties，其余原样复制；targetPath 可调整资源输出相对路径。
            filters 提供额外属性文件，启用前创建该文件；注意与 Spring ${...} 占位符冲突。
            testResources/testResource 结构相同；需要时另配 src/test/resources。
        -->
        <!--
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>build-info.properties</exclude></excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>build-info.properties</include></includes>
            </resource>
        </resources>
        <filters><filter>src/main/filters/build.properties</filter></filters>
        -->

        <!-- extensions 是构建扩展；启动期核心扩展用 .mvn/extensions.xml；普通插件不需设 extensions=true。 -->
        <!--
        <extensions>
            <extension>
                <groupId>com.example</groupId>
                <artifactId>example-build-extension</artifactId>
                <version>1.0.0</version>
            </extension>
        </extensions>
        -->

        <!-- pluginManagement 管版本 / 默认配置；插件经 plugins 或默认生命周期引入后才应用，不凭空新增执行。 -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!--
            plugins：configuration 配参数；executions 用 id 区分执行，phase + goals 决定绑定。
            同插件多次执行用多个 execution，不重复声明 plugin；子 POM 同 execution id 会参与合并。
            inherited=false 可阻止插件/执行配置继承；插件 dependencies 独立于项目依赖管理。
            Maven 运行 JDK 用 mvn -v 检查；需独立编译/测试 JDK 时使用 Toolchains，不是只改 release。
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Surefire 默认绑定 test，无需重复写 execution；配合上方 JUnit 依赖使用。 -->
            <!--
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>
            -->

            <!--
                Failsafe 需绑定两个 goal，默认对应 integration-test / verify；用 mvn verify 保留清理与结果检查。
                Surefire 常识别 *Test，Failsafe 常识别 *IT；均可用 includes/excludes 定制。
                -DskipTests 跳过 Surefire 执行；-DskipITs 跳过 Failsafe；-Dmaven.test.skip=true 还跳过测试编译。
                Failsafe 3.6.0 起不直接响应 skipTests；日常构建不默认跳过测试。
                参考：https://maven.apache.org/surefire/maven-failsafe-plugin/usage.html
            -->
            <!--
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals><goal>integration-test</goal><goal>verify</goal></goals>
                    </execution>
                </executions>
            </plugin>
            -->

            <!-- 普通项目用 Enforcer 限制构建环境；prerequisites/maven 主要用于 Maven 插件项目。 -->
            <!--
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>check-build-environment</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                                <requireJavaVersion><version>[1.8,)</version></requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            -->
        </plugins>
    </build>

    <!-- reporting 用于 mvn site；与 build/plugins 分工不同，可用 reportSets 选择报告。旧 reports 字段不用。 -->
    <!--
    <reporting>
        <outputDirectory>${project.build.directory}/site</outputDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <reportSets>
                    <reportSet><id>api</id><reports><report>javadoc</report></reports></reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>
    -->

    <!--
        profiles 按构建条件叠加属性、依赖、插件、仓库等；Maven profile 不自动激活 Spring profile。
        示例用 -Pdev 或 -Denv=dev 激活。也可用 activation/jdk、os、file；不同类型条件组合为 AND。
        同 POM 的其他 profile 激活后，activeByDefault profile 通常停用；profile id 相同不等于跨模块自动激活。
        参考：https://maven.apache.org/guides/introduction/introduction-to-profiles.html
    -->
    <!--
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <property><name>env</name><value>dev</value></property>
            </activation>
            <properties><build.label>dev</build.label></properties>
        </profile>
    </profiles>
    -->
</project>
