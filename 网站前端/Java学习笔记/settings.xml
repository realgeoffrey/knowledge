<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven settings 速查：Maven 3.9.x / Settings 1.2.0；可选配置均已注释，按场景启用。
    用户级 ~/.m2/settings.xml；全局级 ${maven.home}/conf/settings.xml；冲突以用户级为准。
    -s / -gs 可指定；放在项目目录不会自动加载。
    POM 管项目构建；settings 管仓库、认证、代理与本机差异。
    ${} 只认系统属性与 ${env.变量}；激活的 settings profile properties 可被 POM 引用。
    检查：mvn -s settings.xml help:effective-settings；help:active-profiles
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <!-- 本地仓库默认如下；-Dmaven.repo.local= 可临时覆盖。 -->
    <!-- <localRepository>${user.home}/.m2/repository</localRepository> -->
    <!-- interactiveMode 默认 true（CI 用 -B）；offline 默认 false（-o）。 -->
    <!-- <interactiveMode>true</interactiveMode> -->
    <!-- <offline>false</offline> -->

    <!-- proxies：网络代理，不是仓库账号；nonProxyHosts 用 |，支持 *。 -->
    <proxies>
        <!--
        <proxy>
            <id>company-proxy</id>
            <active>true</active>
            <protocol>http</protocol>
            <host>proxy.example.com</host>
            <port>8080</port>
            <username>${env.PROXY_USER}</username>
            <password>${env.PROXY_PASSWORD}</password>
            <nonProxyHosts>localhost|127.0.0.1|*.example.com</nonProxyHosts>
        </proxy>
        -->
    </proxies>

    <!--
        servers：只认证，不声明仓库地址；id 匹配 repository / mirror / 发布目标。
        密码/token 用环境变量或加密（mvn -emp / -ep），不提交真实凭证。
    -->
    <servers>
        <!--
        <server>
            <id>company-mirror</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        <server>
            <id>company-releases</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        <server>
            <id>company-snapshots</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        -->
        <!-- SSH：privateKey 填路径，勿同时设 password。 -->
        <!--
        <server>
            <id>company-ssh</id>
            <username>${env.REPO_USER}</username>
            <privateKey>${user.home}/.ssh/id_ed25519</privateKey>
            <passphrase>${env.SSH_KEY_PASSPHRASE}</passphrase>
        </server>
        -->
    </servers>

    <!--
        mirrors：替换下载源，不改 deploy 地址。mirrorOf 匹配仓库 id。
        常用：central / * / external:* / *,!repoId。先精确 id，否则首个匹配；失败不回退。
        * 要求入口能提供全部制品（通常私服仓库组）。Maven 3.8.1+ 默认阻止外部 HTTP。
    -->
    <mirrors>
        <!--
        <mirror>
            <id>company-mirror</id>
            <name>Company Repository Group</name>
            <url>https://repo.example.com/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
            <mirrorOfLayouts>*</mirrorOfLayouts>
            <blocked>false</blocked>
        </mirror>
        -->
    </mirrors>

    <!--
        settings profile 仅含 id / activation / properties / repositories / pluginRepositories。
        -P、property、jdk、os、file 或 activeProfiles 激活；多条件 AND。
        activeByDefault 遇同容器其他已激活 profile 会退让。
        profile 内 repositories 下依赖、pluginRepositories 下插件；被 mirrorOf=* 命中仍走镜像。central 默认无快照。
    -->
    <profiles>
        <!--
        <profile>
            <id>company-repo</id>
            <activation>
                <property><name>useCompanyRepo</name><value>true</value></property>
            </activation>
            <properties><team.build.label>local</team.build.label></properties>
            <repositories>
                <repository>
                    <id>company-direct</id>
                    <url>https://repo.example.com/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                        <updatePolicy>daily</updatePolicy>
                        <checksumPolicy>fail</checksumPolicy>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>daily</updatePolicy>
                        <checksumPolicy>fail</checksumPolicy>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>company-direct</id>
                    <url>https://repo.example.com/repository/maven-public/</url>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
        -->
    </profiles>

    <activeProfiles>
        <!-- <activeProfile>company-repo</activeProfile> -->
    </activeProfiles>

    <!-- 插件前缀搜索组；内置 org.apache.maven.plugins / org.codehaus.mojo。 -->
    <pluginGroups>
        <!-- <pluginGroup>com.example.maven.plugins</pluginGroup> -->
    </pluginGroups>
</settings>
