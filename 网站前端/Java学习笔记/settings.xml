<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven settings 速查示例：Maven 3.9.x / Settings 1.2.0；可选配置均已注释，按场景启用并替换占位值。
    用户级 ${user.home}/.m2/settings.xml；全局级 ${maven.home}/conf/settings.xml；合并时用户级冲突项优先。
    -s / -gs 可指定这两类文件；此文件只作为知识示例，不会因放在项目目录就自动加载。
    POM 管项目构建；settings 管仓库、认证、代理和本机差异，不存放项目 dependencies / build。
    参考：https://maven.apache.org/settings.html
          https://maven.apache.org/ref/3.9.15/maven-settings/settings.html
    检查：mvn -s settings.xml help:effective-settings；mvn -s settings.xml help:active-profiles
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <!-- 本地仓库默认如下，缓存下载制品并保存 install 产物；可用 -Dmaven.repo.local=路径 临时覆盖。 -->
    <!-- <localRepository>${user.home}/.m2/repository</localRepository> -->
    <!-- interactiveMode 默认 true；CI 用 -B 非交互。offline 默认 false，-o 离线时需已有依赖和插件。 -->
    <!-- <interactiveMode>true</interactiveMode> -->
    <!-- <offline>false</offline> -->
    <!-- usePluginRegistry 是已弃用的历史字段，现代 Maven 不需配置。 -->

    <!-- proxies 是网络代理，不是仓库账号；nonProxyHosts 用 | 分隔，支持 * 通配。 -->
    <proxies>
        <!--
        <proxy>
            <id>company-proxy</id>
            <active>true</active>
            <protocol>http</protocol>
            <host>proxy.example.com</host>
            <port>8080</port>
            <username>${env.PROXY_USER}</username>
            <password>${env.PROXY_PASSWORD}</password>
            <nonProxyHosts>localhost|127.0.0.1|*.example.com</nonProxyHosts>
        </proxy>
        -->
    </proxies>

    <!--
        servers 只提供认证，不声明仓库地址；id 匹配实际 repository / pluginRepository / mirror / 发布目标 id。
        命中镜像时用 mirror.id；匿名下载通常不用凭证，下载 / 发布权限由服务端决定。
        password 可为密码或 token；使用环境变量或 Maven 密码加密，不提交真实凭证。
        Maven 3 加密：mvn -emp 加密主密码，结果存入 ~/.m2/settings-security.xml 的 settingsSecurity/master；mvn -ep 加密仓库密码。
        加密值仍可被持有主密码者解密；settings 与 settings-security 文件均须限制访问。
        参考：https://maven.apache.org/guides/mini/guide-encryption.html
    -->
    <servers>
        <!-- 配合下方 company-mirror；若直接访问其他仓库，另配同 id 的 server。 -->
        <!--
        <server>
            <id>company-mirror</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        <server>
            <id>company-releases</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        <server>
            <id>company-snapshots</id>
            <username>${env.REPO_USER}</username>
            <password>${env.REPO_TOKEN}</password>
        </server>
        -->
        <!-- SSH 认证是另一种方案：使用支持 SSH 的传输实现，privateKey 填路径，不同时设置 password。 -->
        <!--
        <server>
            <id>company-ssh</id>
            <username>${env.REPO_USER}</username>
            <privateKey>${user.home}/.ssh/id_ed25519</privateKey>
            <passphrase>${env.SSH_KEY_PASSPHRASE}</passphrase>
        </server>
        -->
        <!-- configuration 可放传输实现特有参数，如 HTTP headers；filePermissions/directoryPermissions 也依赖实现。 -->
    </servers>

    <!--
        mirrors 替换下载源，不改变 deploy 上传地址。mirrorOf 匹配仓库 id，不是 URL。
        central：仅中央仓库；*：全部；external:*：排除 localhost 与 file；*,!company-direct：排除指定 id。
        external:http:* 匹配外部 HTTP，Maven 3.8.1+ 默认阻止此类仓库；优先改用 HTTPS。
        先精确匹配 id，否则按顺序选首个匹配模式；每个仓库只选一个镜像，失败不自动回退原地址。
        * 要求入口能提供所有所需制品，通常使用私服仓库组；多个 mirror 不会自动聚合上游。
    -->
    <mirrors>
        <!--
        <mirror>
            <id>company-mirror</id>
            <name>Company Repository Group</name>
            <url>https://repo.example.com/repository/maven-public/</url>
            <mirrorOf>*</mirrorOf>
            <mirrorOfLayouts>*</mirrorOfLayouts>
            <blocked>false</blocked>
        </mirror>
        -->
    </mirrors>

    <!--
        settings profile 仅含 id、activation、properties、repositories、pluginRepositories；POM profile 能力更广。
        下面用 -Pcompany-repo 或 -DuseCompanyRepo=true 激活；也可列入 activeProfiles。
        activation 还可用 jdk（如 [17,)）、os（family/name/arch/version）、file（exists/missing）；多种条件为 AND。
        activeByDefault 不等于始终激活，遇到同容器其他激活的 profile 会退让；显式 -P 不要求条件成立。
        profile 的 properties 可供 POM 使用，但不能用于 settings 自身插值；这里仓库 URL 使用字面值。
        settings 插值可用 ${user.home} 等系统属性和 ${env.REPO_URL} 等环境变量。
    -->
    <profiles>
        <!--
        <profile>
            <id>company-repo</id>
            <activation>
                <property><name>useCompanyRepo</name><value>true</value></property>
            </activation>
            <properties><team.build.label>local</team.build.label></properties>
            <repositories>
                <repository>
                    <id>company-direct</id>
                    <url>https://repo.example.com/repository/maven-public/</url>
                    <releases>
                        <enabled>true</enabled>
                        <updatePolicy>daily</updatePolicy>
                        <checksumPolicy>fail</checksumPolicy>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                        <updatePolicy>daily</updatePolicy>
                        <checksumPolicy>fail</checksumPolicy>
                    </snapshots>
                </repository>
            </repositories>
            <pluginRepositories>
                <pluginRepository>
                    <id>company-direct</id>
                    <url>https://repo.example.com/repository/maven-public/</url>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
        -->
    </profiles>
    <!--
        repositories 下载依赖，pluginRepositories 下载插件；被 mirrorOf=* 命中时仍走镜像。
        releases/snapshots 是允许的版本类型，不是“启用所有仓库”；central 默认不提供快照。
        updatePolicy：always、daily(默认)、interval:分钟、never；-U 强制检查更新快照和缺失 release。
        checksumPolicy：fail、warn(Maven 3 默认)、ignore。这里 fail 表示校验失败即报错。
    -->

    <!-- activeProfiles 持续激活指定 id；CLI -P 可临时激活，mvn help:active-profiles 查看结果。 -->
    <activeProfiles>
        <!-- <activeProfile>company-repo</activeProfile> -->
    </activeProfiles>

    <!-- 插件前缀搜索组，内置 org.apache.maven.plugins / org.codehaus.mojo；不提供插件版本或下载地址。 -->
    <pluginGroups>
        <!-- <pluginGroup>com.example.maven.plugins</pluginGroup> -->
    </pluginGroups>
</settings>
